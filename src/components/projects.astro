---
const projects = [
  {
    title: "Inbox-to-action",
    description: "An AI-powered tool designed to streamline email management by automatically extracting actionable tasks from your inbox.",
    image: "/inbox-to-action.png", 
    status: "Completed",
    github: "https://github.com/vigneshwararaj175/Project/tree/main/Inbox-to-action", 
    live: "#", 
  },
  {
    title: "Planner",
    description: "A smart planning application to help organize tasks and schedules efficiently.",
    image: "/planner.png", 
    status: "Completed",
    github: "https://github.com/vigneshwararaj175/Project/tree/main/Planner",
    live: "#",
  },
  {
    title: "AI Weather Agent",
    description: "An intelligent agent that fetches real-time weather data and provides conversational insights and recommendations.",
    image: "/ai-weather-agent.png",
    status: "Completed",
    github: "https://github.com/vigneshwararaj175/Project/tree/main/ai-weather-agent",
    live: "#",
  },
];
---

<section id="projects" class="w-full max-w-5xl mx-auto py-20 px-6">
  <div class="mb-12">
    <p class="text-[#A9FF5B] text-sm font-medium mb-2">My work</p>
    <h2 class="text-4xl md:text-5xl font-bold text-[var(--white)]">Projects</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {projects.map((project) => (
      <div class="flex flex-col bg-[#1414149c] border border-[var(--white-icon-tr)] rounded-2xl overflow-hidden group">
        
        <!-- Project Image -->
        <div class="relative w-full h-56 bg-[#1a1a1a] overflow-hidden flex items-center justify-center">
          <img 
            src={project.image} 
            alt={project.title} 
            class="object-cover w-full h-full opacity-70 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
            loading="lazy"
          />
        </div>

        <!-- Project Details -->
        <div class="p-6 flex flex-col flex-grow">
          <div class="flex justify-between items-start mb-2">
            <h3 class="text-xl font-bold text-[var(--white)]">{project.title}</h3>
            
            <!-- Links/Icons -->
            <div class="flex gap-2">
              <a href={project.github} target="_blank" rel="noopener noreferrer" class="p-2 bg-[#ffffff10] rounded-lg hover:bg-[#A9FF5B] hover:text-black transition-colors text-[var(--white-icon)]" aria-label="GitHub Repo">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>
              </a>
            </div>
          </div>
          
          <p class="text-[var(--white-icon)] text-sm mb-4 flex-grow">
            {project.description}
          </p>
          
          <div class="mt-auto pt-4 border-t border-[#ffffff10]">
            <span class="text-xs font-medium px-3 py-1 bg-[#A9FF5B]/10 text-[#A9FF5B] rounded-full">
              {project.status}
            </span>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>